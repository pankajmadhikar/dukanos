NODE_ENV=development
PORT=3000
API_PREFIX=api
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Migration, seed, and database-contract tests.
# This role owns the schema. It is not the API role.
# Local Homebrew PostgreSQL often uses your OS user with peer auth.
# Docker Compose in this repo publishes PostgreSQL 18 on host port 54329.
DATABASE_ADMIN_URL=postgresql://MIGRATION_ROLE@localhost:5432/dukaanos?schema=public

# API runtime. Must be dukaan_app (or DATABASE_APP_ROLE): NOSUPERUSER and NOBYPASSRLS.
# npm run db:ensure-app-role grants LOGIN using the password in this URL.
# Do not put a superuser or the migration role here.
DATABASE_URL=postgresql://dukaan_app:replace-with-a-local-password@localhost:5432/dukaanos?schema=public
DATABASE_APP_ROLE=dukaan_app

# Session bearer tokens and the signed shop grant. Use different long random values.
SESSION_SECRET=replace-with-a-long-random-string
OTP_PEPPER=replace-with-a-different-long-random-string
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# console prints the verification code in the API log. Development only.
# Tests always capture the code in memory. Production must not use console.
OTP_PROVIDER=console
