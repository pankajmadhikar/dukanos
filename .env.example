NODE_ENV=development
# development, test, staging, or production.
# staging and production require NODE_ENV=production, https CORS, a non-local
# database, openai, s3, and RATE_LIMIT_STORE=memory (one API process).
APP_ENV=development
RATE_LIMIT_STORE=memory
JSON_BODY_LIMIT=256kb
DB_POOL_SIZE=5
PORT=3000
API_PREFIX=api
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Migration, seed, and database-contract tests.
# This role owns the schema. It is not the API role.
# Local Homebrew PostgreSQL often uses your OS user with peer auth.
# Docker Compose in this repo publishes PostgreSQL 18 on host port 54329.
DATABASE_ADMIN_URL=postgresql://MIGRATION_ROLE@localhost:5432/dukaanos?schema=public

# API runtime. Must be dukaan_app (or DATABASE_APP_ROLE): NOSUPERUSER and NOBYPASSRLS.
# npm run db:ensure-app-role grants LOGIN using the password in this URL.
# Do not put a superuser or the migration role here.
DATABASE_URL=postgresql://dukaan_app:replace-with-a-local-password@localhost:5432/dukaanos?schema=public
DATABASE_APP_ROLE=dukaan_app

# Session bearer tokens and the signed shop grant. Use different long random values.
SESSION_SECRET=replace-with-a-long-random-string
OTP_PEPPER=replace-with-a-different-long-random-string
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# console prints the verification code in the API log. Development only.
# Tests always capture the code in memory. Production must not use console.
OTP_PROVIDER=console

# Intake vision. Development and tests use mock. Production must be openai.
# AI_API_KEY is never logged and is not required for mock.
AI_PROVIDER=mock
AI_VISION_MODEL=
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_CONFIDENCE_THRESHOLD=0.85
AI_INTAKE_PROCESSING_TIMEOUT_MINUTES=10
AI_INTAKE_MEDIA_RETENTION_DAYS=30
AI_INTAKE_MAX_REQUESTS_PER_MINUTE=60
AI_INTAKE_MAX_DAILY_PROCESSES=500
AI_INTAKE_MAX_UPLOAD_BYTES=10485760

# Private intake media. Development and tests use mock. Production must be s3.
# Do not make the bucket public. Clients receive only short-lived URLs.
OBJECT_STORAGE_PROVIDER=mock
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
